guiTypes = {
	# RAN: The Fox's Autocracy. Copied from vanilla russian_mechanics_interaction_gui, resized for 85x85 buttons
	# (the style of Yukari's Shogunate) and given amber gauges.
	windowType = {
		name = "th_fox_autocracy_interaction_gui"
		size = { x = 100 y = 100 }
		backGround = ""
		moveable = 0
		dontRender = ""
		horizontalBorder = ""
		Orientation = "UPPER_LEFT"

		# Interaction button, graphics replaced from the interaction icon specification
		guiButtonType = {
			name = "government_interaction_button"
			quadTextureSprite = "GFX_th_fox_sudebnik"
			position = { x = 7 y = 0 }
			tooltip = ""
			tooltipText = ""
			delayedTooltipText = ""
			buttonFont = "vic_18"
			Orientation = "UPPER_LEFT"
			clicksound = back_click
			text = ""
		}

		# Bar and frame for the power that belongs to this interaction
		iconType = {
			name = "government_power_bar"
			spriteType = "GFX_th_fox_autocracy_power_bar"
			position = { x = 13 y = 78 }
			Orientation = "UPPER_LEFT"
		}

		iconType = {
			name = "government_power_bar_frame"
			spriteType = "GFX_government_power_bar_frame"
			position = { x = -1 y = 74 }
			Orientation = "UPPER_LEFT"
			alwaystransparent = yes
		}
	}

	# The Fox's Rule (after RAN_table_of_ranks): bigger square gold-framed buttons (94x94, full 14px frame; user), like vanilla Russian Rule.
	windowType = {
		name = "th_fox_rule_interaction_gui"
		size = { x = 100 y = 100 }
